# Copy to .env.local (never commit real keys). Restart `npm run dev` after editing.

# ── AI provider ──────────────────────────────────────────────────────────────
# mock (default): scripted replies from src/config/ai.ts, no key needed.
# openai-compatible (aliases: openai, groq, openrouter, gemini, ollama)
AI_PROVIDER=mock

# Secret key. Server-only: never prefix with NEXT_PUBLIC_.
AI_API_KEY=

# Model id for your provider, e.g. gpt-4o-mini, llama-3.3-70b-versatile, gemini-2.0-flash
AI_MODEL=

# Base URL for OpenAI-compatible APIs (leave empty for OpenAI):
#   OpenAI      https://api.openai.com/v1
#   Groq        https://api.groq.com/openai/v1
#   OpenRouter  https://openrouter.ai/api/v1
#   Gemini      https://generativelanguage.googleapis.com/v1beta/openai
#   Ollama      http://localhost:11434/v1   (any non-empty AI_API_KEY, e.g. "ollama")
AI_BASE_URL=

# ── Site ─────────────────────────────────────────────────────────────────────
# Public URL used for metadata, sitemap and robots (set to your Netlify URL).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── AI judge reports ─────────────────────────────────────────────────────────
# HMAC-SHA256 key shared by python-judge (signs) and Next.js (verifies). Server-only.
# Make one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BAYT_REPORT_SECRET=
